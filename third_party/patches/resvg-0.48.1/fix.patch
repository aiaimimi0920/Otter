+#[test]
+fn morphology_matches_naive_transparent_padding() {
+    for width in 1..=5usize {
+        for height in 1..=5usize {
+            let input: Vec<_> = (0..width * height)
+                .map(|i| {
+                    let a = ((i * 71 + width * 31 + height * 17) % 256) as u8;
+                    RGBA8::new(a / 2, a / 3, a, a)
+                })
+                .collect();
+            for rx in 0..=6i32 {
+                for ry in 0..=6i32 {
