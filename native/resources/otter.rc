// 原生 EXE 品牌与三段包版本；内部迭代身份仍由 provenance 记录。
#pragma code_page(65001)
#include "version.h"

1 ICON "icon.ico"

1 VERSIONINFO
 FILEVERSION OTTER_VERSION
 PRODUCTVERSION OTTER_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Otter contributors\0"
            VALUE "FileDescription", "Otter Native\0"
            VALUE "FileVersion", OTTER_VERSION_TEXT
            VALUE "InternalName", "otter-native\0"
            VALUE "OriginalFilename", "otter-native.exe\0"
            VALUE "ProductName", "Otter\0"
            VALUE "ProductVersion", OTTER_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
