{
  "name": "otter",
  "version": "0.3.1",
  "description": "Windows-native desktop capture, sticker editing, and visual workflow workspace.",
  "type": "module",
  "author": "yamiyu",
  "homepage": "https://github.com/aiaimimi0920/Otter#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiaimimi0920/Otter.git"
  },
  "bugs": {
    "url": "https://github.com/aiaimimi0920/Otter/issues"
  },
  "keywords": [
    "windows",
    "screenshot",
    "workflow"
  ],
  "scripts": {
    "dev": "cargo build --locked --workspace --manifest-path native/Cargo.toml && cargo run --locked --manifest-path native/Cargo.toml --bin otter-native",
    "build": "cargo build --locked --release --workspace --manifest-path native/Cargo.toml",
    "check:effective-lines": "node scripts/effective-code-lines.mjs --mode ratchet --json artifacts/effective-code-lines.json",
    "check:effective-lines:strict": "node scripts/effective-code-lines.mjs --mode strict --json artifacts/effective-code-lines-strict.json",
    "verify:version": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\assert-release-version.ps1",
    "version:internal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\bump-internal-version.ps1",
    "test:dependency-security": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tests\\Test-DependencySecurityContract.ps1",
    "audit:dependencies": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\Invoke-DependencySecurityScan.ps1",
    "check:fast": "powershell -NoProfile -Command \"$env:CARGO_TARGET_DIR='native/target-nightly-check'; $env:RUSTFLAGS='-Z threads=6'; cargo +nightly check --locked --offline --workspace --manifest-path native/Cargo.toml --lib\"",
    "test:nextest": "cargo nextest run --locked --workspace --manifest-path native/Cargo.toml",
    "verify:local": "npm run verify:version && npm run check:effective-lines:strict && cargo fmt --all --check --manifest-path native/Cargo.toml && cargo test --locked --workspace --manifest-path native/Cargo.toml -- --test-threads=1 && npm run build",
    "test": "cargo test --locked --workspace --manifest-path native/Cargo.toml -- --test-threads=1",
    "test:effective-lines": "node --test scripts/tests/effective-code-lines.test.mjs"
  },
  "license": "MIT",
  "private": true
}
