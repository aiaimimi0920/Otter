# Installed dependencies and frontend build output; retain lockfiles and generator source.
node_modules/
/dist/
/.vinxi/
/.output/
/.vite/
*.tsbuildinfo

# Cargo build directories, including alternate targets used for isolated verification.
/target/
/target-*/
/target_*/
/native/target/
/native/target-*/
/native/target_*/

# Local runtime state, test evidence and package output.
/.runtime/
/.tmp/
/tmp/
/tmp-*
/artifacts/
/output/
/release/
/coverage/
/test-results/
/playwright-report/
/blob-report/
/otter.exe
/otter-*.exe
*.log

# Local search, code-graph and browser-automation state, independent of global Git configuration.
/.memsearch/
/graphify-out/
/.playwright-cli/
/Microsoft/Windows/PowerShell/ModuleAnalysisCache
/rtk/history.db

# Environments and caches for Python helper scripts.
/.venv/
/venv/
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# Private environment configuration; explicitly retain secret-free examples and templates.
/.env
/.env.*
!/.env.example
!/.env.*.example
!/.env.sample
!/.env.template

# Editor, operating-system and patch temporary files.
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.orig
*.rej
*.swp
*.swo
/NUL
